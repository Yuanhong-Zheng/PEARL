# Query-side LoRA of the retriever (Qwen3-VL-Embedding-2B) on the Past-Time questions of PSVU-10K.
# Sourced by scripts/train_retriever.sh (paper Supp. "Training Settings").
# The clip (document) embeddings stay at the frozen base encoder.

NUM_GPUS=8            # effective batch size = NUM_GPUS x ACCUMULATION = 8
ACCUMULATION=1
MAX_UPDATES=2244      # optimizer steps
LR=2e-5               # AdamW, weight decay 0.01, gradient clipping 1.0 (fixed in train_common.py)
LORA_RANK=16          # LoRA alpha = 2 x rank = 32, dropout 0.05 (fixed in train_common.py)
TEMPERATURE=0.07      # contrastive temperature tau of the multi-positive loss
MAX_LENGTH=8192       # longer inputs are rejected, not truncated
SEED=42
