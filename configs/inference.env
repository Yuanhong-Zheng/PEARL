# PEARL inference and evaluation settings (paper Sec. 4.1 and the supplementary material).
# Sourced by scripts/eval_qwen.sh; its positional arguments override these values.

# Concept-aware retrieval: the K most similar historical clips, each expanded by
# N neighbouring clips on either side.
TOP_K_CLIPS=4
NUM_NEIGHBOR=1

# Fixed in the code, listed for reference:
# - streams are sampled at 1 FPS (FPS in third_party/Qwen3-VL-Embedding/src/models/qwen3_vl_embedding.py
#   and in third_party/qwen-vl-utils/src/qwen_vl_utils/vision_process.py);
# - scene detection (video_scene_splitter.py defaults): ContentDetector threshold 27.0,
#   clips of at least 1 s and at most 8 s, longer scenes split into 8-second clips;
# - cyclic option rotation (--enable_rotation in scripts/eval_qwen.sh): a question is
#   correct only if all four rotations are answered correctly;
# - answering VLM: temperature 0, at most 1,024 new tokens (video_qa_inference.py);
# - embedding model: Qwen3-VL-Embedding-2B, cosine similarity, at most 8,192 tokens.
