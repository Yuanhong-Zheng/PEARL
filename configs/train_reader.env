# LoRA of the answering VLM (Qwen3-VL-8B-Instruct) on PSVU-10K, with all four option rotations.
# Sourced by scripts/train_reader.sh (paper Supp. "Training Settings").
# The reader prompt is the evaluation prompt (protocol pearl-eval-v1).

NUM_GPUS=8            # effective batch size = NUM_GPUS x ACCUMULATION = 8
ACCUMULATION=1
MAX_UPDATES=9140      # about two epochs over the four option rotations
LR=1e-4               # AdamW, weight decay 0.01, gradient clipping 1.0 (fixed in train_common.py)
LORA_RANK=16          # LoRA alpha = 2 x rank = 32, dropout 0.05 (fixed in train_common.py)
MAX_LENGTH=8192       # longer inputs are rejected, not truncated
SEED=42
SAVE_EVERY=1000       # periodic adapter checkpoints
